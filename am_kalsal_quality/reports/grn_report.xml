<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================== -->
    <!-- GRN REPORT ACTION (appears in Print menu)  -->
    <!-- ========================================== -->
    <record id="action_report_grn" model="ir.actions.report">
        <field name="name">Goods Receipt Note</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">am_kalsal_quality.report_grn</field>
        <field name="report_file">am_kalsal_quality.report_grn</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'GRN - %s' % (object.name or '').replace('/', '')</field>
    </record>


    <!-- ========================================== -->
    <!-- GRN TEMPLATE                               -->
    <!-- ========================================== -->
    <template id="report_grn">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">

                        <!-- ============ LETTERHEAD ============ -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:2px;">
                            <tr>
                                <td style="width:22%; border:1px solid black; padding:6px;
                                           vertical-align:middle; text-align:center;">
                                    <img t-if="o.company_id.logo"
                                         t-att-src="image_data_uri(o.company_id.logo)"
                                         style="max-height:55px; max-width:100%; display:block; margin:0 auto;"
                                         alt="Company Logo"/>
                                </td>
                                <td style="width:56%; border:1px solid black; padding:6px;
                                           text-align:center; vertical-align:middle;">
                                    <div style="font-size:20px; font-weight:bold;">
                                        <span t-field="o.company_id.name"/>
                                    </div>
                                    <div style="font-size:11px;">
                                        <span t-field="o.company_id.partner_id.street"/>,
                                        <span t-field="o.company_id.partner_id.city"/>
                                    </div>
                                </td>
                                <td style="width:22%; border:1px solid black; padding:6px;
                                           text-align:center; vertical-align:middle;">
                                    <div style="font-size:26px; font-weight:bold; letter-spacing:2px;">CELAKT</div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="border:1px solid black; text-align:center; padding:6px 0;">
                                    <div style="display:inline-block; border:2px solid black;
                                                padding:4px 40px; font-size:15px; font-weight:bold;">
                                        Goods Receipt Note
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ============ INFO GRID (Supplier / Numbers / Dates) ============ -->
                        <t t-set="grn_date" t-value="o.scheduled_date"/>
                        <table style="width:100%; border-collapse:collapse; font-size:11px; margin-bottom:10px;">
                            <tr>
                                <td rowspan="4"
                                    style="width:30%; border:1px solid black; padding:4px; vertical-align:top;">
                                    <div>From,</div>
                                    <div style="text-align:center; font-weight:bold;">
                                        <span t-field="o.partner_id.name"/>
                                    </div>
                                    <div style="font-size:9px; margin-top:4px; text-align:left;">
                                        <div t-if="o.partner_id.street or o.partner_id.city">
                                            <span t-field="o.partner_id.street"/>
                                            <t t-if="o.partner_id.street2">,
                                                <span t-field="o.partner_id.street2"/>
                                            </t>
                                            <br/>
                                            <span t-field="o.partner_id.city"/>
                                            <t t-if="o.partner_id.state_id">,
                                                <span t-field="o.partner_id.state_id.name"/>
                                            </t>
                                            <span t-field="o.partner_id.zip"/>
                                            <br/>
                                            <span t-field="o.partner_id.country_id.name"/>
                                        </div>
                                        <div t-if="o.partner_id.vat" style="margin-top:2px;">
                                            <strong>NTN:</strong>
                                            <span t-field="o.partner_id.vat"/>
                                        </div>
                                        <div t-if="o.partner_id.phone">
                                            <strong>Ph:</strong>
                                            <span t-field="o.partner_id.phone"/>
                                        </div>
                                        <div t-if="o.partner_id.email">
                                            <strong>Email:</strong>
                                            <span t-field="o.partner_id.email"/>
                                        </div>
                                        <div t-if="o.partner_id.website">
                                            <strong>Web:</strong>
                                            <span t-field="o.partner_id.website"/>
                                        </div>
                                    </div>
                                </td>
                                <td style="width:12%; border:1px solid black; padding:4px;">GRN NO. :</td>
                                <td style="width:28%; border:1px solid black; padding:4px;">
                                    <span t-field="o.name"/>
                                </td>
                                <td style="width:10%; border:1px solid black; padding:4px;">GRN Date :</td>
                                <td style="width:20%; border:1px solid black; padding:4px;">
                                    <span t-esc="grn_date" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid black; padding:4px;">INV NO :</td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-field="o.inv_no"/>
                                </td>
                                <td style="border:1px solid black; padding:4px;">Invoice Date :</td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-field="o.inv_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid black; padding:4px;">CHALLAN NO :</td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-field="o.challan_no"/>
                                </td>
                                <td style="border:1px solid black; padding:4px;">Challan Date :</td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-field="o.challan_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid black; padding:4px;">VEHICLE NO :</td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-field="o.vehicle_id"/>
                                </td>
                                <td style="border:1px solid black; padding:4px;"></td>
                                <td style="border:1px solid black; padding:4px;"></td>
                            </tr>
                        </table>

                        <!-- ============ LINES TABLE ============ -->
                        <t t-set="tot_challan" t-value="sum(o.move_ids.mapped('challan_qty'))"/>
                        <t t-set="tot_received" t-value="sum(o.move_ids.mapped('quantity'))"/>
                        <t t-set="tot_short" t-value="sum(o.move_ids.mapped('short_qty'))"/>
                        <t t-set="tot_excess" t-value="sum(o.move_ids.mapped('excess_qty'))"/>
                        <t t-set="tot_rejected" t-value="sum(o.move_ids.mapped('rejected_qty'))"/>
                        <t t-set="tot_accepted" t-value="sum(o.move_ids.mapped('accepted_qty'))"/>

                        <table style="width:100%; border-collapse:collapse; font-size:10px; text-align:center;">
                            <!-- Column headers -->
                            <tr style="font-weight:bold;">
                                <td style="border:1px solid black; padding:4px; width:4%;">S.No</td>
                                <td style="border:1px solid black; padding:4px; width:9%;">PO No.</td>
                                <td style="border:1px solid black; padding:4px; width:10%;">PO Date</td>
                                <td style="border:1px solid black; padding:4px; width:27%;">Item Description</td>
                                <td style="border:1px solid black; padding:4px; width:6%;">UOM</td>
                                <td style="border:1px solid black; padding:4px; width:9%;">Challan Qty</td>
                                <td style="border:1px solid black; padding:4px; width:8%;">Received Qty</td>
                                <td style="border:1px solid black; padding:4px; width:6%;">Short Qty</td>
                                <td style="border:1px solid black; padding:4px; width:6%;">Excess Qty</td>
                                <td style="border:1px solid black; padding:4px; width:7%;">Rejected Qty</td>
                                <td style="border:1px solid black; padding:4px; width:8%;">Accepted Qty</td>
                            </tr>

                            <!-- Data rows -->
                            <t t-foreach="o.move_ids" t-as="move">
                                <tr>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-esc="move_index + 1"/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-field="move.purchase_id.name"/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-field="move.purchase_order_date" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px; text-align:left;">
                                        <span t-field="move.product_id.display_name"/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-field="move.product_uom.name"/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-field="move.challan_qty"/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-field="move.quantity"/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-field="move.short_qty"/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-field="move.excess_qty"/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-field="move.rejected_qty"/>
                                    </td>
                                    <td style="border:1px solid black; padding:4px;">
                                        <span t-field="move.accepted_qty"/>
                                    </td>
                                </tr>
                            </t>

                            <!-- Blank filler rows (mirror the paper form) -->
                            <t t-foreach="range(0, 8 - len(o.move_ids))" t-as="pad">
                                <tr>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                    <td style="border:1px solid black; padding:4px;">&#160;</td>
                                </tr>
                            </t>

                            <!-- Grand Total row -->
                            <tr style="font-weight:bold;">
                                <td colspan="5" style="border:1px solid black; padding:4px; text-align:right;">Grand
                                    Total:
                                </td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-esc="'%.2f' % tot_challan"/>
                                </td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-esc="'%.2f' % tot_received"/>
                                </td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-esc="'%.2f' % tot_short"/>
                                </td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-esc="'%.2f' % tot_excess"/>
                                </td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-esc="'%.2f' % tot_rejected"/>
                                </td>
                                <td style="border:1px solid black; padding:4px;">
                                    <span t-esc="'%.2f' % tot_accepted"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ============ SIGNATURE FOOTER ============ -->
                        <table style="width:100%; border-collapse:collapse; margin-top:10px; font-size:10px;">
                            <tr>
                                <td style="width:25%; height:60px;"></td>
                                <td style="width:25%;"></td>
                                <td style="width:25%;"></td>
                                <td style="width:25%;"></td>
                            </tr>
                            <tr>
                                <td style="border-top:1px solid black; padding:4px; text-align:center;">PREPARED BY</td>
                                <td style="border-top:1px solid black; padding:4px; text-align:center;">STORE MANAGER
                                </td>
                                <td style="border-top:1px solid black; padding:4px; text-align:center;">INSPECTED BY
                                </td>
                                <td style="border-top:1px solid black; padding:4px; text-align:center;">H.O.D</td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>