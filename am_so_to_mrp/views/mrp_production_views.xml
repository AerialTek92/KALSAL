<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Informational note above the Components list on the MO form -->
    <record id="view_mrp_production_form_shortness_note" model="ir.ui.view">
        <field name="name">mrp.production.form.shortness.note</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']" position="before">
                <div class="alert alert-warning mb-2" role="alert">
                    <strong>Note:</strong> The Shortness quantity is being calculated with a 2%
                    increment of the actual required quantity.
                </div>
            </xpath>
        </field>
    </record>
</odoo>