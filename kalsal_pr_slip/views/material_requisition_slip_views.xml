<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ FORM ============ -->
    <record id="view_material_requisition_slip_form" model="ir.ui.view">
        <field name="name">material.requisition.slip.form</field>
        <field name="model">material.requisition.slip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancel', 'done')"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Internal Transfer</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="MRS No"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id"
                                   readonly="state != 'draft'"
                                   domain="[('stock_ready', '=', True)]"/>

                            <!-- Invisible field holding allowed products -->
                            <field name="allowed_recipe_product_ids" invisible="1"/>

                            <!-- Domain applied directly on the field -->
                            <field name="recipe_product_id"
                                   readonly="state != 'draft' or not sale_order_id"
                                   required="sale_order_id"
                                   domain="[('id', 'in', allowed_recipe_product_ids)]"/>

                            <field name="kgs" readonly="state != 'draft' or not sale_order_id"/>
                            <field name="bom_id" force_save="1" />
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="quantity" readonly="state != 'draft'"/>
                            <field name="uom_id"/>
                            <field name="to_department_id"
                                   readonly="state != 'draft'"/>
                            <field name="bom_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recipe Lines">
                            <field name="recipe_line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sno" readonly="1"/>
                                    <field name="item_code"/>
                                    <field name="item_description"/>
                                    <field name="product_id" column_invisible="1"/>
                                    <field name="uom_id"/>
                                    <field name="quantity_required"/>
                                    <field name="quantity_issued"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ LIST ============ -->
    <record id="view_material_requisition_slip_list" model="ir.ui.view">
        <field name="name">material.requisition.slip.list</field>
        <field name="model">material.requisition.slip</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'confirmed'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="sale_order_id"/>
                <field name="recipe_product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="to_department_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="view_material_requisition_slip_search" model="ir.ui.view">
        <field name="name">material.requisition.slip.search</field>
        <field name="model">material.requisition.slip</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="recipe_product_id"/>

                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_so" string="Sale Order"
                            context="{'group_by': 'sale_order_id'}"/>
                    <filter name="group_dept" string="Department"
                            context="{'group_by': 'to_department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="action_material_requisition_slip" model="ir.actions.act_window">
        <field name="name">Material Requisition Slips</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">material.requisition.slip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_material_requisition_slip_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Material Requisition Slip
            </p>
        </field>
    </record>

</odoo>