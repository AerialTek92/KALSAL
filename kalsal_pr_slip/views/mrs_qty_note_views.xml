<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Yellow note above the Recipe Lines list on the MRS form -->
    <record id="view_material_requisition_slip_form_qty_note" model="ir.ui.view">
        <field name="name">material.requisition.slip.form.qty.note</field>
        <field name="model">material.requisition.slip</field>
        <field name="inherit_id" ref="kalsal_pr_slip.view_material_requisition_slip_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='recipe_line_ids']" position="before">
                <div class="alert alert-warning mb-2" role="alert">
                    <strong>Note:</strong> The quantities of these products are
                    issuing with the 2% increment.
                </div>
            </xpath>
        </field>
    </record>
</odoo>