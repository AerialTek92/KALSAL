<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_finished_qc_form" model="ir.ui.view">
        <field name="name">finished.qc.form</field>
        <field name="model">finished.qc</field>
        <field name="arch" type="xml">
            <form string="Finished Goods QC">
                <header>
                    <button name="action_start" string="Start Testing" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pass" string="Pass QC" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_fail" string="Fail QC" type="object"
                            class="btn-danger" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,passed,failed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Document Info -->
                    <group string="Document Information">
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="sale_order_id" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="batch_no" readonly="1" force_save="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="performed_by_id"/>
                        </group>
                        <group string="Sampling &amp; Environment">
                            <field name="sample_condition" readonly="state != 'in_progress'"/>
                            <field name="temperature" readonly="state != 'in_progress'"/>
                            <field name="sampling_date" readonly="state != 'in_progress'"/>
                            <field name="testing_date" readonly="state != 'in_progress'"/>
                            <field name="reporting_date" readonly="state != 'in_progress'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB 1: Standard Tests ONLY -->
                        <page string="Test Parameters">
                            <field name="standard_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="parameter_id" readonly="1" force_save="1"/>
                                    <field name="test_parameter" column_invisible="1"/>
                                    <field name="specification" readonly="1" force_save="1"/>
                                    <field name="condition" readonly="1" force_save="1"/>
                                    <field name="result" readonly="parent.state != 'in_progress'"/>
                                    <field name="status"
                                           decoration-success="status == 'pass'"
                                           decoration-danger="status == 'fail'"
                                           decoration-warning="status == 'pending'"
                                           readonly="parent.state != 'in_progress'"/>
                                    <field name="remarks" readonly="parent.state != 'in_progress'"/>
                                </list>
                            </field>
                        </page>

                        <!-- TAB 2: Microbiological Tests ONLY (E.coli & Salmonella) -->
                        <page string="Microbiological Tests">
                            <field name="microbiological_line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="parameter_id" readonly="1" force_save="1"/>
                                    <field name="test_parameter" column_invisible="1"/>
                                    <field name="specification" readonly="1" force_save="1"/>
<!--                                    <field name="condition" readonly="1" force_save="1"/>-->
                                    <!-- hidden but force-saved so the synced text survives -->
                                    <field name="result" column_invisible="1" force_save="1"/>
                                    <field name="detection_result"
                                           string="Detection (Mandatory)"
                                           readonly="parent.state != 'in_progress'"
                                           decoration-success="detection_result == 'absent'"
                                           decoration-danger="detection_result == 'present'"/>
                                    <field name="status"
                                           decoration-success="status == 'pass'"
                                           decoration-danger="status == 'fail'"
                                           decoration-warning="status == 'pending'"
                                           readonly="1"/>
                                    <field name="remarks" readonly="parent.state != 'in_progress'"/>
                                </list>
                            </field>

                            <div class="alert alert-info mt-2" role="alert">
                                <strong>Important:</strong>
                                You MUST select <strong>Absent</strong> or
                                <strong>Present</strong>
                                for every pathogen. Selecting <strong>Present</strong> marks the line as Fail —
                                remarks are then mandatory in order to pass the QC.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_finished_qc_list" model="ir.ui.view">
        <field name="name">finished.qc.list</field>
        <field name="model">finished.qc</field>
        <field name="arch" type="xml">
            <list string="Finished Goods QC"
                  decoration-success="state == 'passed'"
                  decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="date"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="batch_no"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_finished_qc" model="ir.actions.act_window">
        <field name="name">Finished Goods QC</field>
        <field name="res_model">finished.qc</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_finished_qc"
              name="Finished Goods QC"
              parent="am_kalsal_quality.menu_vehicle_inspection_root"
              action="action_finished_qc"
              sequence="20"/>

</odoo>