<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================== -->
    <!-- 1. FINISHED GOODS REPORTING FORM VIEW      -->
    <!-- ========================================== -->
    <record id="view_fg_reporting_form" model="ir.ui.view">
        <field name="name">fg.reporting.form</field>
        <field name="model">fg.reporting</field>
        <field name="arch" type="xml">
            <form string="Finished Goods Reporting">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>

                <sheet>
                    <!-- NEW: Smart button for the generated transfer -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transfer"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Internal</span>
                                <span class="o_stat_text">Transfer</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group string="Document Information">
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="allowed_sale_order_ids" invisible="1"/>
                            <field name="sale_order_id" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Finished Goods Lines">
                            <!-- Field NOT readonly in draft so onchange-built lines
                                 render; locked entirely once confirmed -->
                            <field name="line_ids" readonly="state == 'confirmed'">
                                <list editable="bottom" create="0" delete="0">
                                    <!-- AUTO FIELDS — force_save so onchange values survive -->
                                    <field name="sno" readonly="1" force_save="1"/>
                                    <field name="product_id" readonly="1" force_save="1"/>
                                    <field name="lot_id" readonly="1" force_save="1"/>

                                    <!-- MANUAL FIELDS -->
                                    <field name="cartons_to_be_produced"/>
                                    <field name="cartons_produced"/>
                                    <field name="boxes_to_be_produced"/>
                                    <field name="boxes_produced"/>
                                    <field name="reason_short_excess"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- 2. FINISHED GOODS REPORTING LIST VIEW      -->
    <!-- ========================================== -->
    <record id="view_fg_reporting_list" model="ir.ui.view">
        <field name="name">fg.reporting.list</field>
        <field name="model">fg.reporting</field>
        <field name="arch" type="xml">
            <list string="Finished Goods Reporting"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'confirmed'">
                <field name="name"/>
                <field name="date"/>
                <field name="sale_order_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- 3. WINDOW ACTION & MENU (Manufacturing)    -->
    <!-- ========================================== -->
    <record id="action_fg_reporting" model="ir.actions.act_window">
        <field name="name">Finished Goods Reporting</field>
        <field name="res_model">fg.reporting</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Finished Goods Report
            </p>
            <p>Only Sale Orders with a passed Semi-Finished QC are selectable.</p>
        </field>
    </record>

    <menuitem id="menu_fg_reporting"
              name="FG Reporting"
              parent="mrp.menu_mrp_root"
              action="action_fg_reporting"
              sequence="31"/>

</odoo>