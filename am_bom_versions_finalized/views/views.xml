<odoo>
    <data>

        <record id="view_order_form_inherit_fg_smart_button" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.fg.smart.button</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- Insert inside the Smart Button Box -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_fg_mos"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cogs"
                            invisible="fg_mo_count == 0">
                        <field name="fg_mo_count" widget="statinfo" string="FG MOs"/>
                    </button>
                </xpath>

            </field>
        </record>


        <!-- Fully Fixed View: Safely hides helper field and positions Recipe Version right after Product -->
        <record id="view_order_form_inherit_rd" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.rd</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Target the description (name) column field to inject elements right before it -->
                <xpath expr="//field[@name='order_line']/list/field[@name='s_no']" position="after">
                    <field name="finished_product_tmpl_id" column_invisible="True"/>

                    <field name="finished_product_id" optional="show"/>

                    <!-- Readonly until FG is selected -->
                    <field name="fg_bom_id" optional="show" readonly="not finished_product_id"/>

                    <!-- Readonly until BOM is selected -->
                    <!-- NEW: Cartons Field -->
                    <field name="carton_qty"
                           optional="show"
                           readonly="not fg_bom_id or (finished_product_qty &gt; 0 and carton_qty == 0)"/>

                    <!-- FG Units: Readonly if FG BOM is empty, OR if user is using Cartons (> 0) -->
                    <field name="finished_product_qty"
                           optional="show"
                           readonly="not fg_bom_id or carton_qty &gt; 0"
                           force_save="1"/>
                    <field name="fg_mo_id" optional="show" invisible="fg_mo_id == False"/>
                </xpath>

                <!-- Modify the standard product_id to be readonly until the FG BOM is selected -->
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                    <attribute name="readonly">not fg_bom_id</attribute>
                    <!-- force_save ensures that even if it's readonly on screen, it still saves to the database properly -->
                    <attribute name="force_save">1</attribute>
                    <attribute name="string">Semi-Finish Product</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
