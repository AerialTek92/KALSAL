<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_cogs" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cogs</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_cogs_sales_analysis)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-line-chart"
                        context="{'default_sale_order_id': id, 'default_name': 'New'}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">View</span>
                        <span class="o_stat_text">COGS</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>