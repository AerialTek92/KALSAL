<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ FORM ============ -->
    <record id="view_swab_testing_report_form" model="ir.ui.view">
        <field name="name">swab.testing.report.form</field>
        <field name="model">swab.testing.report</field>
        <field name="arch" type="xml">
            <form string="Swab Testing Report">
                <header>
                    <button name="action_pass" type="object" string="Pass Test"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_fail" type="object" string="Fail Test"
                            class="btn-danger" invisible="state != 'draft'"/>
                    <button name="action_print_swab" type="object"
                            string="Print Swab Report" class="btn-primary"
                            invisible="state == 'draft'"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,passed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group string="Sampling Information">
                        <group>
                            <field name="sampling_information" readonly="state != 'draft'"/>
                            <field name="temperature" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="effective_date" readonly="state != 'draft'"/>
                            <field name="sample_condition" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Microbiological Testing Results">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sno" readonly="1"/>
                                    <field name="sampling_receiving_date"/>
                                    <field name="testing_date"/>
                                    <field name="customer_location" readonly="1"/>
                                    <field name="product_id"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="batch_id"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="total_bacterial_count"/>
                                    <field name="s_aureus"/>
                                    <field name="total_coliforms"/>
                                    <field name="mold_yeast_count"/>
                                    <field name="e_coli"/>
                                    <field name="salmonella"/>
                                    <field name="performed_by" readonly="1"/>
                                    <field name="reporting_date"/>
                                    <field name="remarks_status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group string="Conclusion">
                        <div class="text-muted" colspan="4">
                            N/R = Not required, N/A = Not available.
                            <br/>
                            Note: The above result and conclusion is valid only for the sample tested.
                        </div>
                        <group>
                            <field name="deviation_from_methods" readonly="state != 'draft'"/>
                            <field name="measurement_uncertainty" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="interpretation_additional" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ LIST ============ -->
    <record id="view_swab_testing_report_list" model="ir.ui.view">
        <field name="name">swab.testing.report.list</field>
        <field name="model">swab.testing.report</field>
        <field name="arch" type="xml">
            <list string="Swab Testing Reports"
                  decoration-success="state == 'passed'"
                  decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="effective_date"/>
                <field name="sampling_information"/>
                <field name="sample_condition"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ============ ACTION & MENU ============ -->
    <record id="action_swab_testing_report" model="ir.actions.act_window">
        <field name="name">Swab Testing Report</field>
        <field name="res_model">swab.testing.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_swab_testing_report"
              name="Swab Testing"
              parent="am_kalsal_quality.menu_vehicle_inspection_root"
              action="action_swab_testing_report"
              sequence="22"/>

</odoo>