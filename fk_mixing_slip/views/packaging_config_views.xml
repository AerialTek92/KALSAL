<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product form: carton master data next to Category Type -->
    <record id="view_product_template_form_carton" model="ir.ui.view">
        <field name="name">product.template.form.carton.config</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Target a native field that ALWAYS exists in the base view -->
            <xpath expr="//field[@name='categ_id']" position="after">
                <!-- Bring product_type_custom into the view invisibly so the
                     invisible condition on semi_product_id can evaluate it -->
                <field name="product_type_custom" invisible="1"/>

                <field name="pcs_per_carton" string="Packs Per Carton" invisible="product_type_custom != 'finished'"/>

                <!-- CHANGED: Selection -> Many2many tags, user-creatable types,
                     visible only on Semi-Finished and Finished Goods products -->
                <field name="recipe_category_ids"
                       widget="many2many_tags"
                       invisible="product_type_custom not in ('semi', 'finished')"/>

            </xpath>
        </field>
    </record>

    <!-- Semi-Finished Recipe Version: right after Recipe Version, before Quantity -->
    <record id="view_sale_order_form_semi_version" model="ir.ui.view">
        <field name="name">sale.order.form.semi.recipe.version</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='bom_id']" position="after">
                <field name="allowed_semi_bom_ids" column_invisible="1"/>
                <field name="semi_bom_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Cartons column: right before Quantity; typing cartons fills pieces and vice-versa -->
    <record id="view_sale_order_form_cartons" model="ir.ui.view">
        <field name="name">sale.order.form.cartons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="carton_qty" optional="show" width="auto"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="before">
                <field name="carton_qty" width="auto"/>
            </xpath>
        </field>
    </record>

</odoo>
