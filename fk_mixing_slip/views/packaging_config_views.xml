<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. List View Price Hiding -->
        <record id="view_product_template_list_hide_prices" model="ir.ui.view">
            <field name="name">product.template.list.hide.prices</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='list_price']" position="attributes">
                    <attribute name="groups">fk_kalsal_security.group_executor_procurement</attribute>
                </xpath>
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="groups">fk_kalsal_security.group_executor_procurement</attribute>
                </xpath>
            </field>
        </record>

        <!-- 2. Kanban View Price Hiding -->
        <record id="view_product_template_kanban_hide_prices" model="ir.ui.view">
            <field name="name">product.template.kanban.hide.prices</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//main/span" position="attributes">
                    <attribute name="groups">fk_kalsal_security.group_executor_procurement</attribute>
                </xpath>
            </field>
        </record>

        <!-- 3. Product Form Carton Master Data -->
        <record id="view_product_template_form_carton" model="ir.ui.view">
            <field name="name">product.template.form.carton.config</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">

                <!-- Hide Sales Price Label -->
                <xpath expr="//label[@for='list_price']" position="attributes">
                    <attribute name="groups">fk_kalsal_security.group_executor_procurement</attribute>
                </xpath>

                <!-- Hide Sales Price Field Wrapper (Fixed missing bracket) -->
                <xpath expr="//group[@name='group_standard_price']/div[@name='list_price_uom']" position="attributes">
                    <attribute name="groups">fk_kalsal_security.group_executor_procurement</attribute>
                </xpath>

                <xpath expr="//label[@for='standard_price']" position="attributes">
                    <attribute name="groups">fk_kalsal_security.group_executor_procurement</attribute>
                </xpath>

                <!-- Hide Sales Price Field Wrapper (Fixed missing bracket) -->
                <xpath expr="//group[@name='group_standard_price']/div[@name='standard_price_uom']" position="attributes">
                    <attribute name="groups">fk_kalsal_security.group_executor_procurement</attribute>
                </xpath>
                
                <xpath expr="//field[@name='taxes_id']" position="attributes">
                    <attribute name="groups">fk_kalsal_security.group_executor_procurement</attribute>
                </xpath>

                <xpath expr="//field[@name='supplier_taxes_id']" position="attributes">
                    <attribute name="groups">fk_kalsal_security.group_executor_procurement</attribute>
                </xpath>


                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="uom_id" string="Unit of Measure"/>
                    <field name="product_type_custom" invisible="1"/>
                    <field name="pcs_per_carton" string="Packs Per Carton"
                           invisible="product_type_custom != 'finished'"/>
                    <field name="recipe_category_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True}"
                           invisible="product_type_custom not in ('semi', 'finished')"/>
                </xpath>
            </field>
        </record>

        <!-- 4. Sale Order Semi-Finished Recipe Version -->
        <record id="view_sale_order_form_semi_version" model="ir.ui.view">
            <field name="name">sale.order.form.semi.recipe.version</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//field[@name='bom_id']" position="after">
                    <field name="allowed_semi_bom_ids" column_invisible="1"/>
                    <field name="semi_bom_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- 5. Cartons Column in Sale Order -->
        <record id="view_sale_order_form_cartons" model="ir.ui.view">
            <field name="name">sale.order.form.cartons</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                    <field name="carton_qty" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="before">
                    <field name="carton_qty"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>